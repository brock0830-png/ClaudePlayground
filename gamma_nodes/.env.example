# Copy to gamma_nodes/.env (never commit .env) and fill in.
UW_API_KEY=your-unusual-whales-api-key

# Setup A (your own computer, Google Drive for desktop):
#   Windows: DATA_ROOT=G:\My Drive\uw_gamma_data
#   macOS:   DATA_ROOT=~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/uw_gamma_data
# Setup B (cloud session + rclone): a local staging folder; finished days are
#   copied to the rclone remote below and checked before the local copy is deleted.
DATA_ROOT=

# Setup B only
RCLONE_REMOTE=gdrive:uw_gamma_data
